# Plantilla de variables de entorno para transparencia-gobcan.
# Copiar a `.env` y rellenar. El fichero `.env` NUNCA se sube al repositorio.
# En producción estos valores viven en GitHub Secrets, no en disco.

# --- Base de datos ----------------------------------------------------------
# La carga usa psycopg2 contra PostgreSQL, no el cliente REST de Supabase, así
# que hacen falta credenciales de BASE DE DATOS, no la clave de la API.
#
# USA EL POOLER, no la conexión directa. El host directo
# (db.<ref>.supabase.co) solo publica registro IPv6, y ni esta red ni los
# runners de GitHub Actions tienen salida IPv6: la conexión falla con
# "nodename nor servname provided". El pooler responde por IPv4.
#
# La cadena exacta está en el dashboard de Supabase, en Connect > Session
# pooler. Ojo a dos detalles que no son evidentes:
#   - el usuario es `postgres.<ref-del-proyecto>`, no `postgres` a secas;
#   - el prefijo del host puede ser aws-0 o aws-1 según el proyecto. El de
#     bd_odesocan es aws-1: con aws-0 el pooler responde
#     "tenant/user not found", que parece un fallo de contraseña y no lo es.
# Sustituye [TU-CONTRASENA] por la contraseña de la BASE DE DATOS, que no es
# la de tu cuenta de Supabase. Si no la recuerdas, se regenera en
# Project Settings > Database > Reset database password.
DATABASE_URL=postgresql://postgres.kdpsjutsgvghdtzoskkg:[TU-CONTRASENA]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Opción B: variables sueltas, igual que en el resto de Canarias en Datos.
# Solo se usan si DATABASE_URL está vacía.
# CED_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
# CED_DB_PORT=5432
# CED_DB_NAME=postgres
# CED_DB_USER=postgres.kdpsjutsgvghdtzoskkg
# CED_DB_PASSWORD=
# CED_DB_SSLMODE=require

# Schema de destino. No debería hacer falta cambiarlo.
SUPABASE_SCHEMA=transp_gobcan

# --- Correo de alertas ------------------------------------------------------
# Servidor SMTP para el envío del resumen de decisiones detectadas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
ALERTAS_REMITENTE=alertas@odesocan.org
# Lista separada por comas
ALERTAS_DESTINATARIAS=investigacion@odesocan.org

# --- Ejecución --------------------------------------------------------------
# Identificador del entorno: local | produccion
ENTORNO=local

# Ventana de la carga incremental, en horas hacia atrás desde el momento
# de ejecución. La carga histórica inicial usa su propio parámetro en el CLI.
VENTANA_INCREMENTAL_HORAS=24

# Nivel de registro: DEBUG | INFO | WARNING | ERROR
NIVEL_LOG=INFO
