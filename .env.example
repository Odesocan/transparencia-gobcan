# Plantilla de variables de entorno para transparencia-gobcan.
# Copiar a `.env` y rellenar. El fichero `.env` NUNCA se sube al repositorio.
# En producción estos valores viven en GitHub Secrets, no en disco.

# --- Supabase ---------------------------------------------------------------
# URL del proyecto (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave de servicio. Tiene permisos de escritura sobre el schema transp_gobcan.
# No usar la clave anónima: no puede escribir en el schema.
SUPABASE_SERVICE_KEY=

# Schema de destino. No debería hacer falta cambiarlo.
SUPABASE_SCHEMA=transp_gobcan

# --- Correo de alertas ------------------------------------------------------
# Servidor SMTP para el envío del resumen de decisiones detectadas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
ALERTAS_REMITENTE=alertas@odesocan.org
# Lista separada por comas
ALERTAS_DESTINATARIAS=investigacion@odesocan.org

# --- Ejecución --------------------------------------------------------------
# Identificador del entorno: local | produccion
ENTORNO=local

# Ventana de la carga incremental, en horas hacia atrás desde el momento
# de ejecución. La carga histórica inicial usa su propio parámetro en el CLI.
VENTANA_INCREMENTAL_HORAS=24

# Nivel de registro: DEBUG | INFO | WARNING | ERROR
NIVEL_LOG=INFO
